# Required for Sepolia. Keep the real values in contracts/.env.
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
SEPOLIA_INITIAL_ADMIN=

# Optional local administrator override. By default Hardhat account #0 is used.
LOCAL_INITIAL_ADMIN=
LOCAL_RPC_URL=http://127.0.0.1:8545

# Used by mint:sepolia. Demo data is fictional and permanently public.
DEMO_RECIPIENT=
